# Copy to /opt/edeltraud/api.env (outside the repository), then: chmod 600 /opt/edeltraud/api.env
PORT=8787
# Random secret for the proof of work. Create with: openssl rand -hex 32
POW_SECRET=
POW_DIFFICULTY=16
# The proxy on this server sets X-Forwarded-For; the API then counts the real client address.
TRUST_PROXY=1
# Only if the proxy (e.g. Caddy) runs in its own Docker container: its Docker network.
# Find it with: docker inspect <caddy-container> -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
# The Caddyfile then says: reverse_proxy edeltraud-api:8787
PROXY_NETWORK=
# Page and API share the origin scan.m-ko.de; m-ko.de itself may call the API too.
ALLOWED_ORIGINS=https://scan.m-ko.de,https://m-ko.de
# Domains whose operators asked not to be scanned, comma separated.
BLOCKED_DOMAINS=
# Secret for ownership tokens of the deep check (wave 3). Create with: openssl rand -hex 32
OWNERSHIP_SECRET=

# Watch (weekly runs, mails only on changes)
WATCH_DIR=/data/watch
# Signs unsubscribe links. Create with: openssl rand -hex 32
WATCH_SECRET=
PUBLIC_BASE_URL=https://scan.m-ko.de
# Mail (Hetzner): smtps://watchmen%40m-ko.de:<password>@mail.your-server.de:465
# Special characters in user/password must be percent-encoded: @ → %40, ] → %5D, # → %23, : → %3A, / → %2F
SMTP_URL=
MAIL_FROM=EDEL.TRAUD.AI <watchmen@m-ko.de>

# Paddle (payment). Start with sandbox; switch PADDLE_ENV=production only after Paddle's approval.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
# Public token for the payment page (Paddle > Developer tools > Authentication > Client-side tokens)
PADDLE_CLIENT_TOKEN=
# Printed once by: node scripts/paddle-setup.ts --webhook
PADDLE_WEBHOOK_SECRET=
# Printed by: node scripts/paddle-setup.ts
PADDLE_PRICE_REPORT=
PADDLE_PRICE_DEEP=
PADDLE_PRICE_WATCHDOG=
PADDLE_PRICE_WATCHDOG_Y=
# Paid jobs (report, deep check)
JOBS_DIR=/data/jobs
MAIL_ADMIN=post@m-ko.de
