{
  "name": "edeltraud",
  "version": "0.1.0",
  "description": "EDEL.TRAUD.AI – finds typical flaws in AI-built (vibe-coded) web apps",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "edeltraud": "./src/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "scan": "node src/cli/main.ts",
    "api": "node src/api/server.ts",
    "demo": "node scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "license": "AGPL-3.0-only"
}
