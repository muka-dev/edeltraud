# Worker for paid plans (report, deep, watch): same code as the API, plus headless Chromium.
# Run it in a network without access to internal services: Chromium resolves names itself,
# so the SSRF check before each request cannot rule out DNS rebinding on its own.
#   docker build -f Dockerfile.worker -t edeltraud-worker .
#   docker run --rm --network edeltraud-egress edeltraud-worker https://example.com --plan report --json
FROM node:26-slim
WORKDIR /app
ARG PLAYWRIGHT_VERSION=1.63.0
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
 && npm install --no-save playwright-core@${PLAYWRIGHT_VERSION} \
 && npx playwright-core install --with-deps chromium \
 && chmod -R a+rX /ms-playwright \
 && rm -rf /root/.npm /var/lib/apt/lists/*
COPY src ./src
COPY plans ./plans
COPY vendor ./vendor
USER node
ENTRYPOINT ["node", "src/cli/main.ts"]
